*.log
.DS_Store
Thumbs.db

# Commit tooling run with `npm install --no-save git-cz`. Never part of this
# repository: it is third-party code carrying its own licences, and this repo
# is MIT. `git add -A` will otherwise stage the lot.
node_modules/
cz-run.mjs
