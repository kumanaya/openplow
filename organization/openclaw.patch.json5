{
  // Every role gets `profile: "minimal"` and grants its own tools back with
  // `alsoAllow`. The base ships the whole deployment on `profile: "messaging"`,
  // which is the right default for a general assistant and far too wide for a
  // customer-facing support desk. Subtracting from a wide profile means every
  // tool OpenClaw adds to `messaging` in a future release silently reaches all
  // three roles, because a `deny` array is a closed list of names somebody has
  // to remember to extend. Granting upward cannot rot that way.
  //
  // The `deny` lists are kept anyway. Deny wins over allow, so they stay the
  // backstop for anything the base's own global `tools.alsoAllow` contributes
  // (`read`, `write`, `edit`, `exec`, `plow_start_thread`).
  //
  // `sessions_spawn` is denied as part of a group, not alone. OpenClaw grants
  // `sessions`, `sessions_spawn`, `sessions_yield` and `subagents` together as
  // the spawn lifecycle; denying only the spawn would still leave the Curator
  // able to cancel the Investigator's run, and any role able to reset, delete
  // or reassign a visible session.
  //
  // `tools.agentToAgent` is deliberately absent. The base owns the `tools`
  // object through an `$include`, and the pinned OpenClaw refuses to write
  // there — `config patch` fails with "would flatten $include-owned config at
  // tools", the same wall materialize-main-binding.mjs exists to work around
  // for bindings. Cross-agent access is closed by the deny lists instead:
  // `sessions`, `sessions_send`, `sessions_list`, `sessions_history`,
  // `sessions_search` and `subagents` are denied for all three roles, so no
  // role keeps a tool that can reach another role's session. If one of those
  // denies is ever relaxed, cross-agent access reopens with it.
  agents: {
    entries: {
      main: {
        subagents: {
          allowAgents: ["investigator", "curator"],
          requireAgentId: true
        },
        tools: {
          profile: "minimal",
          // The four tools the children own MUST be named here too, and this
          // is not a privilege for `main`. A subagent's callable tool set is
          // the intersection of its own allowlist with the parent's
          // "inherited tools.allow", not a union - so a child can only ever
          // receive a tool its parent already carries. Without these four
          // entries the Investigator silently loses `case_claim` (it keeps
          // `read`, reads pages, and can never claim) and the Curator resolves
          // to an empty set and dies before the model speaks with "No callable
          // tools remain after resolving explicit tool allowlist".
          //
          // Granting them to `main` cannot widen what Frontline does with
          // them: plugin/case-workflow/policy.js refuses any case tool whose
          // owner is not the calling role, so `case_claim` reaches the
          // Investigator and `case_prepare_candidate` reaches the Curator and
          // no call from `main` ever executes.
          alsoAllow: [
            "read", "sessions_spawn", "case_create", "case_resolve",
            "case_claim", "case_verify", "case_block", "case_prepare_candidate",
            // `bundle-mcp` rides the same path for the same reason: the
            // Investigator's Latch bridge is unreachable unless the parent
            // carries it. `main` denies `bundle-mcp` in the list below and
            // deny wins over allow, so naming it here delivers the bridge to
            // the Investigator without giving Frontline one.
            "bundle-mcp"
          ],
          deny: [
            "bundle-mcp", "exec", "process", "browser", "canvas", "nodes", "gateway",
            "message", "conversations_list", "conversations_send", "conversations_turn", "plow_start_thread",
            "write", "edit", "apply_patch", "sessions_list", "sessions_history",
            "sessions_search", "sessions_send",
            "sessions", "sessions_yield", "subagents"
          ]
        }
      },
      investigator: {
        workspace: "/var/lib/plow/agents/investigator/workspace",
        agentDir: "/var/lib/plow/agents/investigator/agent",
        subagents: { allowAgents: [], requireAgentId: true },
        tools: {
          profile: "minimal",
          alsoAllow: ["read", "bundle-mcp", "case_claim", "case_verify", "case_block"],
          deny: [
            "write", "edit", "apply_patch", "exec", "process", "browser", "canvas", "nodes", "gateway",
            "message", "conversations_list", "conversations_send", "conversations_turn", "plow_start_thread",
            "sessions_list", "sessions_history", "sessions_search", "sessions_send", "sessions_spawn",
            "sessions", "sessions_yield", "subagents"
          ]
        }
      },
      curator: {
        workspace: "/var/lib/plow/agents/curator/workspace",
        agentDir: "/var/lib/plow/agents/curator/agent",
        subagents: { allowAgents: [], requireAgentId: true },
        tools: {
          // One tool. Everything else the Curator needs is inside
          // `case_prepare_candidate`.
          profile: "minimal",
          alsoAllow: ["case_prepare_candidate"],
          deny: [
            "bundle-mcp", "read", "exec", "process", "browser", "canvas", "nodes", "gateway",
            "write", "edit", "apply_patch", "message", "conversations_list", "conversations_send", "conversations_turn",
            "plow_start_thread", "sessions_list", "sessions_history", "sessions_search", "sessions_send", "sessions_spawn",
            "sessions", "sessions_yield", "subagents"
          ]
        }
      }
    }
  }
}
